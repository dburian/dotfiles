#!/bin/python3
#
# Script for trying out new base16 themes with tinty
#

import argparse
import json
import os
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument("--light", action='store_true', help="Cycle only light themes.")
parser.add_argument("--dark", action='store_true', help="Cycle only dark themes.")


def get_cmd_output(cmd):
    return subprocess.check_output(cmd, shell=True, encoding='utf-8').strip()


def set_theme(theme, preview: bool = True):
    # While previewing, skip hooks with side effects (e.g. pushing nvim colors to remote machines)
    env = {**os.environ, 'TINTY_NO_SYNC': '1'} if preview else None
    subprocess.run(['tinty', 'apply', theme], env=env)


def curr_theme():
    return get_cmd_output('tinty current')


def get_all_themes(args):
    schemes = json.loads(get_cmd_output('tinty list --json'))
    themes = []
    for s in schemes:
        if s['system'] != 'base16':
            continue
        if (args.light and s['variant'] != 'light') or \
                (args.dark and s['variant'] != 'dark'):
            continue
        themes.append(s['id'])
    return sorted(themes)


def cycle_colors(args):
    themes = get_all_themes(args)
    old_theme = curr_theme()
    theme_ind = -1
    for i, t in enumerate(themes):
        if t == old_theme: theme_ind = i

    print(f'Old theme: {old_theme}')
    print('Cycling themes using \'tinty\' command:')

    end = False
    while not end:
        theme_ind = (theme_ind + 1) % len(themes)
        set_theme(themes[theme_ind])
        print(f'Current theme: {themes[theme_ind]}')
        end = input('Again [y]/n: ') == 'n'

    set_theme(themes[theme_ind], preview=False)


if __name__ == '__main__':
  args = parser.parse_args()
  cycle_colors(args)
